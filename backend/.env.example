# MoE-GUARDIAN Backend Configuration
APP_ENV=development
DATABASE_URL=sqlite:///./moe_guardian_dev.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Active HMAC-SHA256 Audit Snapshot Signing Key
HMAC_KEY_ID=key-v1-local
HMAC_SIGNING_SECRET=dev-only-replace-in-production-hmac-secret-key-2026
# Optional Retired Verification-Only Keys for Key Rotation (Format: key_id_old:secret_old,key_id_older:secret_older)
HMAC_RETIRED_KEYS=

# Tenant Authentication & Supabase JWT Configuration
REQUIRE_VERIFIED_TENANT_AUTH=false
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# VisualGuard & Tesseract OCR Configuration
VISUALGUARD_OCR_ENABLED=false
TESSERACT_CMD=
OCR_MIN_CONFIDENCE=60.0

# Optional External LLM Provider Configuration
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL_ID=